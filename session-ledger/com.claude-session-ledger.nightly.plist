<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>
    <!-- Launched through bash on purpose: macOS TCC attributes a launchd
         agent's file access to its program. A python3 program is refused
         iCloud Drive paths (~/Library/Mobile Documents) with EPERM; the same
         python3 exec'd from /bin/bash is allowed, so a LEDGER_FILE inside an
         iCloud-synced Obsidian vault works. run-alerted.sh runs python3 as
         a child of that bash and sends a Pushover alert for any failure
         ledger.py could not report itself (python missing, Xcode license
         exit 69, a crash before its own alert). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO_DIR__/session-ledger/run-alerted.sh</string>
        <string>--sweep</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__CLAUDE_DIR__/session-ledger.log</string>
    <key>StandardErrorPath</key>
    <string>__CLAUDE_DIR__/session-ledger.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CLAUDE_CONFIG_DIR</key>
        <string>__CLAUDE_DIR__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
